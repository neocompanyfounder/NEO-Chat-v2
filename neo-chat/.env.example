# ============================================
# NEO Chat WhatsApp AI RAG Engine
# Environment Configuration Template
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# --------------------------------------------
# Google Cloud Services
# --------------------------------------------
# Google API Key for Gemini (LLM + Embeddings), Vision (OCR), and Speech-to-Text
# Get your API key from: https://makersuite.google.com/app/apikey
# Required for: FR-008a, FR-015a, FR-025a
GOOGLE_API_KEY=your_google_api_key_here

# --------------------------------------------
# Evolution API (WhatsApp Integration)
# --------------------------------------------
# Evolution API base URL (default for local development)
# Required for: FR-001b
EVOLUTION_API_URL=http://localhost:8080

# Evolution API key for authentication
EVOLUTION_API_KEY=your_evolution_api_key_here

# Evolution API instance name
EVOLUTION_INSTANCE_NAME=your_instance_name

# Evolution API timeout in seconds
EVOLUTION_TIMEOUT=10

# --------------------------------------------
# PostgreSQL Database with pgvector
# --------------------------------------------
# PostgreSQL connection string with pgvector extension
# Format: postgresql://user:password@host:port/database
# Required for: FR-016b (Vector storage and retrieval)
DATABASE_URL=postgres://postgres:ESlMOrLQzt7ovJ3f8vzW4yZ432F83qjRR3h38gUkR3YoF19m5TFnwWI3ZRYMEZQg@rg8kcssoscggosgkwg44w40c:5432/postgres

# Database query timeout in seconds
DATABASE_TIMEOUT=5

# --------------------------------------------
# Application Settings
# --------------------------------------------
# Logging level: DEBUG, INFO, WARN, ERROR, CRITICAL
# Required for: FR-030b
LOG_LEVEL=INFO

# Environment: development, staging, production
ENVIRONMENT=development

# FastAPI application host
HOST=0.0.0.0

# FastAPI application port
PORT=8000

# --------------------------------------------
# RAG Pipeline Configuration
# --------------------------------------------
# Minimum tokens per chunk
# Required for: FR-014
MIN_CHUNK_TOKENS=100

# Maximum tokens per chunk
MAX_CHUNK_TOKENS=500

# Overlap tokens between chunks
CHUNK_OVERLAP_TOKENS=50

# --------------------------------------------
# Rate Limiting
# --------------------------------------------
# Gemini API rate limit (requests per minute)
# Required for: FR-008d
GEMINI_RATE_LIMIT=60

# WhatsApp rate limit (messages per minute per user)
# Required for: FR-003a
WHATSAPP_RATE_LIMIT=60

# --------------------------------------------
# API Timeouts (seconds)
# --------------------------------------------
# Gemini API timeout
# Required for: FR-031b
GEMINI_TIMEOUT=30

# Evolution API timeout (already defined above)
# EVOLUTION_TIMEOUT=10

# Supabase timeout (already defined above)
# SUPABASE_TIMEOUT=5

# --------------------------------------------
# Optional: Development Settings
# --------------------------------------------
# Enable debug mode (verbose logging)
DEBUG=false

# Enable auto-reload for development
RELOAD=true

# --------------------------------------------
# Optional: Advanced Configuration
# --------------------------------------------
# Maximum file size for uploads (bytes) - 16MB default per WhatsApp limit
MAX_FILE_SIZE=16777216

# Maximum concurrent users
MAX_CONCURRENT_USERS=100

# Vector search similarity threshold
VECTOR_SIMILARITY_THRESHOLD=0.7

# Number of top results to retrieve from vector search
VECTOR_SEARCH_TOP_K=5

# Maximum context tokens for LLM
MAX_CONTEXT_TOKENS=8000

# Web crawling maximum pages
MAX_CRAWL_PAGES=100

# Web crawling rate limit (requests per second per domain)
CRAWL_RATE_LIMIT=1

# Voice message maximum duration (seconds)
MAX_VOICE_DURATION=60

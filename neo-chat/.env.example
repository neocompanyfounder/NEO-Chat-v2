# NEO Chat Environment Configuration
# ⚠️  SECURITY WARNING: Never commit this file with real credentials!
# Keep .env in .gitignore and use secure secret management in production

# Evolution API (WhatsApp Integration)
# Get your Evolution API credentials from: https://evolution-api.com
# Format: https://your-domain.com or http://localhost:8080
# After setup: http://localhost:8080 (Docker) or your deployed URL
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=f8e7d6c5b4a3928170695847362514039281706958473625140392817069584736
EVOLUTION_INSTANCE_NAME=neo-chat

# Google Cloud APIs (Unified Key)
# This single key is used for: Gemini LLM, Vision OCR, and Speech-to-Text
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=AIzaSyCg1jq87tUQB-Jq6nFl6f28NYYo0dZGz1g
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Supabase (Self-Hosted via Docker)
# Connection via Supavisor pooler (port 6543) for better connection management
# Format: postgresql://user:password@host:port/database
# After running: bash scripts/setup_supabase.sh
SUPABASE_URL=postgresql://postgres:your-super-secret-and-long-postgres-password@localhost:6543/postgres
# Service role key: Full access for backend operations (get from docker/supabase/.env)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
# Anon key: Public access for client operations (get from docker/supabase/.env)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Application Settings
# APP_ENV: development, staging, or production
APP_ENV=development
# LOG_LEVEL: DEBUG, INFO, WARN, ERROR (per FR-030b)
LOG_LEVEL=INFO
# MAX_FILE_SIZE_MB: WhatsApp limit is 16MB (FR-002a, FR-013c)
MAX_FILE_SIZE_MB=16
# MAX_CONCURRENT_USERS: Maximum simultaneous active users
MAX_CONCURRENT_USERS=100

# Rate Limiting
GEMINI_RATE_LIMIT_PER_MIN=60
WHATSAPP_RATE_LIMIT_PER_MIN=60

# Timeouts (seconds)
GEMINI_TIMEOUT=30
EVOLUTION_TIMEOUT=10
SUPABASE_TIMEOUT=5

# Retry Configuration
MAX_RETRIES=5
RETRY_BACKOFF_BASE=1

# Vector Search
# VECTOR_SIMILARITY_THRESHOLD: Range 0.0-1.0, higher = stricter matching (FR-017b)
VECTOR_SIMILARITY_THRESHOLD=0.7
# VECTOR_TOP_K: Number of similar chunks to retrieve (FR-017b)
VECTOR_TOP_K=5
# MAX_CONTEXT_TOKENS: Maximum tokens for LLM context (FR-017c)
MAX_CONTEXT_TOKENS=8000

# Chunking
MIN_CHUNK_TOKENS=100
MAX_CHUNK_TOKENS=2000

# Web Crawling
MAX_CRAWL_PAGES=100
CRAWL_TIMEOUT_MINUTES=5
CRAWL_RATE_LIMIT_SECONDS=1

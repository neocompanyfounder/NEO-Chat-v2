# ============================================================================
# NEO Chat - Coolify Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!
# ============================================================================

# ============================================================================
# GOOGLE CLOUD SERVICES (REQUIRED)
# ============================================================================
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable these APIs:
# 1. Generative Language API (Gemini)
# 2. Cloud Vision API
# 3. Cloud Speech-to-Text API
GOOGLE_API_KEY=your_google_api_key_here

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL database credentials
# Generate secure password: openssl rand -base64 32
POSTGRES_DB=neochat
POSTGRES_USER=neochat_user
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD_32_CHARS_MIN

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
# Redis password for caching and rate limiting
# Generate secure password: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_TO_SECURE_REDIS_PASSWORD

# ============================================================================
# EVOLUTION API (WhatsApp) CONFIGURATION
# ============================================================================
# Evolution API Key - Generate a secure random string
# Generate: openssl rand -hex 32
EVOLUTION_API_KEY=CHANGE_ME_TO_SECURE_EVOLUTION_KEY

# Evolution API Server URL (your public domain)
EVOLUTION_SERVER_URL=https://evolution.neoo.com.sa

# WhatsApp Instance Name (can be any name you want)
EVOLUTION_INSTANCE_NAME=neochat

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# Environment: development, staging, or production
ENVIRONMENT=production

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# OPTIONAL: ADVANCED CONFIGURATION
# ============================================================================
# These have sensible defaults, only change if needed

# Chunking Configuration
MIN_CHUNK_TOKENS=100
MAX_CHUNK_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# Rate Limiting (requests per minute)
GEMINI_RATE_LIMIT=60
WHATSAPP_RATE_LIMIT=60

# Timeouts (in seconds)
GEMINI_TIMEOUT=30
EVOLUTION_TIMEOUT=10
SUPABASE_TIMEOUT=5

# ============================================================================
# INSTRUCTIONS FOR GENERATING SECURE PASSWORDS
# ============================================================================
#
# On Linux/Mac:
#   openssl rand -base64 32
#   openssl rand -hex 32
#
# On Windows (PowerShell):
#   -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | % {[char]$_})
#
# Or use online generator (make sure it's HTTPS):
#   https://www.random.org/passwords/
#
# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. NEVER commit this file with real credentials to Git
# 2. Use strong, unique passwords for each service
# 3. Rotate passwords regularly (every 90 days)
# 4. Store backup of credentials in secure password manager
# 5. Limit access to this file (chmod 600 .env)
# ============================================================================
